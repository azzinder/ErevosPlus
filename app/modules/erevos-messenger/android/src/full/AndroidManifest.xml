<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Session calls ring over the lock screen. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <application>
    <!-- What a move to another edition carries for these engines (erevos-device MoveNet.kt): Messenger's,
         Signal's and Session's folders, their Keystore-sealed keys opened and sealed again there, so
         the accounts go on as they were, signed in. -->
    <meta-data
      android:name="erevos.move.carry.messenger"
      android:value="files:messenger;files:signal;sealed:erevos.messenger.chatlock.wrap:files:signal/db.key;files:session;sealed:erevos.messenger.chatlock.wrap:files:session/data.key" />
    <activity
      android:name="eu.erevos.messenger.calls.SessionCallActivity"
      android:exported="false"
      android:launchMode="singleTop"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    <activity
      android:name="expo.modules.erevosmessenger.WebSignInActivity"
      android:exported="false"
      android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name="expo.modules.erevosmessenger.FacebookActivity"
      android:exported="false"
      android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
      android:windowSoftInputMode="adjustResize" />
    <activity
      android:name="expo.modules.erevosmessenger.MessengerCaseActivity"
      android:exported="false"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
      android:windowSoftInputMode="adjustResize" />
  </application>
</manifest>
