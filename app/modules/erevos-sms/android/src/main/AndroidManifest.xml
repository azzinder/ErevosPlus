<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.telephony" android:required="false" />

  <uses-permission android:name="android.permission.SEND_SMS" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.READ_SMS" />
  <uses-permission android:name="android.permission.RECEIVE_MMS" />
  <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
  <!-- Never used, but Android counts an SMS app without it as not the SMS app (SmsApplication's
       app ops), and the SMS role gives it only to an app that asks for it. -->
  <uses-permission android:name="android.permission.READ_CELL_BROADCASTS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Asked for only when the owner turns them on: which SIM, and names from the phone's contacts. -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <!-- SMS sent for later go at their time with Erevos closed (LaterSms.kt): an exact alarm, set
       again when the phone starts. Android 13 and later give USE_EXACT_ALARM at install. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- What Android asks of a default SMS app: these four parts. -->
    <receiver
      android:name="expo.modules.erevossms.SmsDeliverReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_DELIVER" />
      </intent-filter>
    </receiver>

    <receiver
      android:name="expo.modules.erevossms.MmsDeliverReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_WAP_PUSH">
      <intent-filter>
        <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
        <data android:mimeType="application/vnd.wap.mms-message" />
      </intent-filter>
    </receiver>

    <service
      android:name="expo.modules.erevossms.RespondViaSmsService"
      android:exported="true"
      android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
      <intent-filter>
        <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="sms" />
        <data android:scheme="smsto" />
        <data android:scheme="mms" />
        <data android:scheme="mmsto" />
      </intent-filter>
    </service>

    <!-- sms: and mms: links (Receivers.kt): handed to Erevos, in a task of their own (taskAffinity
         ""), so each opens its conversation, not Erevos as it was left. -->
    <activity
      android:name="expo.modules.erevossms.ComposeActivity"
      android:taskAffinity=""
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SENDTO" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="sms" />
        <data android:scheme="smsto" />
        <data android:scheme="mms" />
        <data android:scheme="mmsto" />
      </intent-filter>
    </activity>

    <!-- SMS as an icon of its own in the launcher (SmsOpenActivity, Receivers.kt, by the aliases
         below), in a task of its own like Phone's and Contacts's, so each tap opens the SMS list, not
         Erevos as it was left. -->
    <activity
      android:name="expo.modules.erevossms.SmsOpenActivity"
      android:taskAffinity=""
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- SMS's launcher icon, one per colour the owner can choose (Appearance → Launcher icons,
         modules/erevos-icons): only one is on, the blue one at first. -->
    <activity-alias
      android:name="expo.modules.erevossms.SmsLauncherRed"
      android:targetActivity="expo.modules.erevossms.SmsOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_sms_launcher_red"
      android:roundIcon="@mipmap/erevos_sms_launcher_red"
      android:label="@string/erevos_sms_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevossms.SmsLauncherOrange"
      android:targetActivity="expo.modules.erevossms.SmsOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_sms_launcher_orange"
      android:roundIcon="@mipmap/erevos_sms_launcher_orange"
      android:label="@string/erevos_sms_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevossms.SmsLauncherGreen"
      android:targetActivity="expo.modules.erevossms.SmsOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_sms_launcher_green"
      android:roundIcon="@mipmap/erevos_sms_launcher_green"
      android:label="@string/erevos_sms_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevossms.SmsLauncherActivity"
      android:targetActivity="expo.modules.erevossms.SmsOpenActivity"
      android:enabled="true"
      android:exported="true"
      android:icon="@mipmap/erevos_sms_launcher_blue"
      android:roundIcon="@mipmap/erevos_sms_launcher_blue"
      android:label="@string/erevos_sms_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevossms.SmsLauncherViolet"
      android:targetActivity="expo.modules.erevossms.SmsOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_sms_launcher_violet"
      android:roundIcon="@mipmap/erevos_sms_launcher_violet"
      android:label="@string/erevos_sms_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevossms.SmsLauncherDark"
      android:targetActivity="expo.modules.erevossms.SmsOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_sms_launcher_dark"
      android:roundIcon="@mipmap/erevos_sms_launcher_dark"
      android:label="@string/erevos_sms_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>

    <!-- SMS invites between Erevos phones: data SMS to a port, which messaging apps do not show. -->
    <receiver
      android:name="expo.modules.erevossms.InviteReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.intent.action.DATA_SMS_RECEIVED" />
        <data android:scheme="sms" android:host="*" android:port="16180" />
      </intent-filter>
    </receiver>

    <receiver android:name="expo.modules.erevossms.SentReceiver" android:exported="false" />
    <!-- Copy code on the notice of an SMS that came (OneTimeCode.kt). -->
    <receiver android:name="expo.modules.erevossms.CopyCodeReceiver" android:exported="false" />
    <!-- Reply and Mark as read on the notice of an SMS that came (NoticeReply.kt). -->
    <receiver android:name="expo.modules.erevossms.NoticeReplyReceiver" android:exported="false" />
    <receiver android:name="expo.modules.erevossms.DeliveredReceiver" android:exported="false" />
    <receiver android:name="expo.modules.erevossms.MmsSentReceiver" android:exported="false" />
    <receiver android:name="expo.modules.erevossms.MmsDownloadedReceiver" android:exported="false" />
    <receiver android:name="expo.modules.erevossms.LaterSmsReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>

    <!-- MMS files, opened by the phone's MMS service for one call each (Android grants it). -->
    <provider
      android:name="expo.modules.erevossms.MmsFiles"
      android:authorities="${applicationId}.erevossms.mms"
      android:exported="false"
      android:grantUriPermissions="true" />
  </application>
</manifest>
