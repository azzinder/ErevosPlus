<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- What a move to another edition carries for TDLib (erevos-device MoveNet.kt): each space's
         database, encrypted by TDLib with a key from the space, so its Telegram goes on signed in.
         The media files are not carried: they download again as they are opened. -->
    <meta-data android:name="erevos.move.carry.telegram" android:value="nobackup:telegram/*/db" />
  </application>
</manifest>
