<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.telephony" android:required="false" />

  <!-- What the phone app role gives: calling, the phone's state (its SIMs), the call history (to
       read it and delete calls from it), and names and photos from the phone's contacts. -->
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <!-- The voicemail tab (Voicemail.kt): the phone app role gives these too, to read every
       voicemail, and to mark one heard or delete it. Without them the tab stays hidden. -->
  <uses-permission android:name="com.android.voicemail.permission.READ_VOICEMAIL" />
  <uses-permission android:name="com.android.voicemail.permission.WRITE_VOICEMAIL" />
  <!-- The call notices, the call screen over the lock screen, the screen off at the ear. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- What Android asks of a phone app: a call screen Telecom binds (it rings itself), and an
         activity for DIAL and tel: links. -->
    <service
      android:name="expo.modules.erevosphone.CallService"
      android:exported="true"
      android:permission="android.permission.BIND_INCALL_SERVICE">
      <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
      <intent-filter>
        <action android:name="android.telecom.InCallService" />
      </intent-filter>
    </service>

    <!-- What Telecom asks about each call that comes, before it rings, once Erevos holds the call
         screening role too: the blocking rules (Rules.kt). -->
    <service
      android:name="expo.modules.erevosphone.ScreeningService"
      android:exported="true"
      android:permission="android.permission.BIND_SCREENING_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.CallScreeningService" />
      </intent-filter>
    </service>

    <!-- Phone as an icon of its own in the launcher, opening the keypad (DialActivity.kt). It and
         the other activities that only hand a link to Erevos and close have a task of their own
         (taskAffinity ""), which ends as they close: in Erevos's task, a second tap on the icon
         only brought Erevos up as it was left, not on the keypad. -->
    <activity
      android:name="expo.modules.erevosphone.PhoneOpenActivity"
      android:taskAffinity=""
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Phone's launcher icon, one per colour the owner can choose (Appearance → Launcher icons,
         modules/erevos-icons): only one is on. The green one keeps the name the icon had before
         colours, so an icon already on the home screen stays. -->
    <activity-alias
      android:name="expo.modules.erevosphone.PhoneLauncherRed"
      android:targetActivity="expo.modules.erevosphone.PhoneOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_phone_launcher_red"
      android:roundIcon="@mipmap/erevos_phone_launcher_red"
      android:label="@string/erevos_phone_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevosphone.PhoneLauncherOrange"
      android:targetActivity="expo.modules.erevosphone.PhoneOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_phone_launcher_orange"
      android:roundIcon="@mipmap/erevos_phone_launcher_orange"
      android:label="@string/erevos_phone_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevosphone.PhoneLauncherActivity"
      android:targetActivity="expo.modules.erevosphone.PhoneOpenActivity"
      android:enabled="true"
      android:exported="true"
      android:icon="@mipmap/erevos_phone_launcher_green"
      android:roundIcon="@mipmap/erevos_phone_launcher_green"
      android:label="@string/erevos_phone_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevosphone.PhoneLauncherBlue"
      android:targetActivity="expo.modules.erevosphone.PhoneOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_phone_launcher_blue"
      android:roundIcon="@mipmap/erevos_phone_launcher_blue"
      android:label="@string/erevos_phone_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevosphone.PhoneLauncherViolet"
      android:targetActivity="expo.modules.erevosphone.PhoneOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_phone_launcher_violet"
      android:roundIcon="@mipmap/erevos_phone_launcher_violet"
      android:label="@string/erevos_phone_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name="expo.modules.erevosphone.PhoneLauncherDark"
      android:targetActivity="expo.modules.erevosphone.PhoneOpenActivity"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/erevos_phone_launcher_dark"
      android:roundIcon="@mipmap/erevos_phone_launcher_dark"
      android:label="@string/erevos_phone_launcher">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>

    <activity
      android:name="expo.modules.erevosphone.DialActivity"
      android:taskAffinity=""
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.DIAL" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.DIAL" />
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="tel" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.dir/calls" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.CALL_BUTTON" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- The call screen: its own task, over the lock screen, outside the app and its password. -->
    <activity
      android:name="expo.modules.erevosphone.CallActivity"
      android:exported="false"
      android:launchMode="singleTask"
      android:taskAffinity="expo.modules.erevosphone.call"
      android:excludeFromRecents="true"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

    <receiver android:name="expo.modules.erevosphone.CallActionReceiver" android:exported="false" />
  </application>
</manifest>
