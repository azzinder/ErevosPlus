<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Where the phone is, once, when a place is sent from a chat: asked for then, never before.
       Declared for Android 6 and later this way, so it does not clash with erevos-radio's location,
       which is kept for Bluetooth on Android 12 and older. -->
  <uses-permission-sdk-23 android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission-sdk-23 android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- The reminders of Chat with myself (Reminders.kt): a notice at their time, their alarm set
       again when the phone starts. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- An invite or a contact link given by touching phones (NfcShare.kt), on phones that can. -->
  <uses-permission android:name="android.permission.NFC" />
  <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

  <!-- The panic apps Erevos tells as it wipes (Panic.kt, tellAll), as Fasouli: the apps that take
       PanicKit's TRIGGER, which Android 11 and later show only to an app that says so. -->
  <queries>
    <intent>
      <action android:name="info.guardianproject.panic.action.TRIGGER" />
    </intent>
  </queries>
  <queries>
    <!-- The other editions (Move.kt), whose move this one may take: Android 11 and later show
         another app only to one that names it. -->
    <package android:name="app.erevos" />
    <package android:name="app.erevos.plus" />
    <package android:name="app.erevos.lite" />
  </queries>

  <application>
    <!-- The panic button (Panic.kt, PanicActivity.kt): PanicKit's requests from a panic app the
         owner chose. Exported, as panic apps must reach it; it trusts only the app the owner said
         yes to, as Android names it, and shows nothing. -->
    <activity
      android:name="expo.modules.erevosdevice.PanicActivity"
      android:taskAffinity=""
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="info.guardianproject.panic.action.TRIGGER" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <intent-filter>
        <action android:name="info.guardianproject.panic.action.CONNECT" />
        <action android:name="info.guardianproject.panic.action.DISCONNECT" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
    <!-- NfcShare.kt: only Android's NFC service may reach it, and it answers only while Erevos shows an
         invite or a contact link. -->
    <service
      android:name="expo.modules.erevosdevice.NfcShare"
      android:exported="true"
      android:permission="android.permission.BIND_NFC_SERVICE">
      <intent-filter>
        <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
      </intent-filter>
      <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/erevos_nfc_share" />
    </service>
    <!-- A move to another edition of Erevos (Move.kt): exported, as the edition moved to reads it,
         but it answers only an app signed with this one's key. -->
    <provider
      android:name="expo.modules.erevosdevice.MoveProvider"
      android:authorities="${applicationId}.move"
      android:exported="true"
      android:grantUriPermissions="false" />
    <receiver android:name="expo.modules.erevosdevice.ReminderReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
